# Строка подключения к SQLite. Папка data будет создана при первом запуске.
DATABASE_URL=sqlite:///./data/lead_intake.db

# Ключ доступа к API заявок.
API_KEY=replace_with_a_strong_api_key

# HTTP Basic-учётные данные административного интерфейса.
ADMIN_USERNAME=replace_with_an_admin_username
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Ключ Fernet в URL-safe base64. Сгенерируйте уникальное значение для каждого окружения.
SECRETS_KEY=replace_with_a_fernet_key

# JSONL-логи на хосте: ежедневный gzip-архив и срок хранения архивов.
LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
